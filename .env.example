# Copy to .env and fill in. `docker compose` reads .env automatically.

# Meilisearch admin key. Any string of 16+ bytes; generate one with:
#   openssl rand -hex 32
MEILI_MASTER_KEY=change-me-to-a-long-random-string

# Bearer token the MCP endpoint requires as `Authorization: Bearer <token>`.
# Anything written with it is recorded as done by `agent`. The server refuses
# to start without a token unless MCP_ALLOW_ANONYMOUS=1.
#   openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# More tokens, each with the name recorded as the actor on what it writes —
# one per agent or person, so the activity log says who did what.
# MCP_TOKENS=bdr-agent:secret1,sam:secret2

# A real address you monitor. SEC EDGAR and Wikimedia require it in the
# User-Agent and will block traffic that omits it.
CONTACT_EMAIL=you@example.com

# Which market config to bake into the images (verticals and profiles).
# MARKET_FILE=market.example.toml

# Optional: extra company homepages to crawl, and extra RSS/Atom feeds on top
# of the ones the market config lists per vertical.
# CRAWL_SEEDS=https://www.example-brewery.com,https://www.example-3pl.com
# NEWS_FEEDS=https://example-trade-press.test/feed

# Optional overrides. Sources: requests, edgar, wikidata, crawl, jobs, news.
# SOURCE_INTERVALS=edgar=1h,wikidata=6h,crawl=10m,jobs=30m,news=30m
# DISABLED_SOURCES=edgar
# RUST_LOG=info,bot=debug
#
# Production only: the MCP server's scoped Meilisearch keys. Mint them with
# `make mcp-keys` (deploy/create-mcp-keys.sh) once Meilisearch is running.
# MEILI_READ_KEY=
# MEILI_WRITE_KEY=
